Mods: {
	SnekVanity: {
		ExtraTooltip: {
			CanAlsoUseAsDye: Can also be used as dye
			PaintsAsDyesItem: "{$CanAlsoUseAsDye}"
			HairDyesAsDyesItem: "{$CanAlsoUseAsDye}"
			CanBeWorn: Can also be worn as a vanity accessory
		}

		Items: {
			AllSkinDyeItem: {
				DisplayName: Face Paint
				Tooltip: Applies dye to skin
			}

			AlwaysClosedContacts: {
				DisplayName: Eye Caps
				Tooltip:
					'''
					'For mortician use only'
					Forces eyes closed
					<right> to fold in half
					'''
			}

			AlwaysOpenContacts: {
				DisplayName: Wire Speculums
				Tooltip:
					'''
					Forces eyes open
					<right> to fold in half
					'''
			}

			BasicArmband: {
				DisplayName: Armband
				Tooltip: ""
			}

			SkirtItem: {
				DisplayName: Skirt
				Tooltip: ""
			}

			EyeDyeItem: {
				DisplayName: Contact Lenses
				Tooltip:
					'''
					'Made with the finest glass around!'
					Applies dye to cornea
					'''
			}

			HideArmsItem: {
				DisplayName: Armless Harness
				Tooltip:
					'''
					'For when amputation is a wee bit excessive'
					Hides your arms
					'''
			}

			NeverClosedContacts: {
				DisplayName: Semi-Speculums
				Tooltip:
					'''
					Forces eyes to never be fully closed
					<right> to fold in half
					'''
			}

			NeverOpenContacts: {
				DisplayName: Half Caps
				Tooltip:
					'''
					'Still only for dead bodies'
					Forces eyes to never be fully open
					<right> to unfold
					'''
			}

			PantsDyeItem: {
				DisplayName: Tie-Dye Bucket
				Tooltip: Applies dye to your pants
			}

			ScleraDyeItem: {
				DisplayName: Scleral Contacts
				Tooltip: Applies dye to sclera
			}

			ShirtDyeItem: {
				DisplayName: Tie-Dye Kit
				Tooltip:
					'''
					'Incredibly messy'
					Applies dye to your shirt
					'''
			}

			ShoesDyeItem: {
				DisplayName: Shoe Polish
				Tooltip:
					'''
					'Spit-shine!'
					Applies dye to your shoes
					'''
			}

			UndershirtDyeItem: {
				DisplayName: Lesser Tie-Dye Kit
				Tooltip:
					'''
					'Just as messy as the normal kind'
					Applies dye to your undershirt
					'''
			}

			CustomHairDyeItem: {
				DisplayName: DIY Hair Dye
				Tooltip:
					'''
					'Try not to stain the sink!'
					Applies dye to hair
					'''
			}

			MixedDyeCommon: {
				Instructions:
					'''
					<right> this item with a dye in hand to add it
					<right> this item with an empty hand to take a dye out
					'''
				MixingNone: Mixing: No dyes...
				Mixing: Mixing:
				MixingListItem: - {0} {1}
				MixingTooltipHint: (Press SHIFT to see dye names)
			}

			OverlaidMixedDyeItem: {
				DisplayName: DIY Dye Bottle
				Tooltip:
					'''
					Combines the effects of two dyes put into it
					{$MixedDyeCommon.Instructions}
					'''
			}

			VerticalGradientMixedDyeItem: {
				DisplayName: DIY Vertical Gradient Dye Bottle
				Tooltip:
					'''
					Vertically combines the effects of up to four dyes put into it
					{$MixedDyeCommon.Instructions}
					'''
			}

			HorizontalGradientMixedDyeItem: {
				DisplayName: DIY Horizontal Gradient Dye Bottle
				Tooltip:
					'''
					Horizontally combines the effects of up to four dyes put into it
					{$MixedDyeCommon.Instructions}
					'''
			}

			ForbiddenArmorSigilItem: {
				DisplayName: Forbidden Sigil
				Tooltip:
					'''
					'Very forbidden'
					If you already have a sigil, dyeing this item dyes the sigil
					'''
			}

			JapaneseUmbrellaItem: {
				DisplayName: Wanderer's Umbrella
				TooltipFlavor: "'From where it came from, none may know, but it is now yours to wield as a shield against the elements'"
				TooltipStandalone:
					'''
					{$TooltipFlavor}
					{$ItemTooltip.Umbrella}
					'''
				TooltipParasol: "{$TooltipFlavor}"
			}

			AllClothesDyeItem: {
				DisplayName: Complete Coloring Kit
				Tooltip:
					'''
					'It's like jumping into a vat of paint'
					Applies dye to your clothing
					'''
			}

			AllPlayerTexturesDyeItem: {
				DisplayName: Complete Coloring Kit Plus
				Tooltip:
					'''
					'Better than jumping into a vat of paint'
					Applies dye to your skin, clothing, eyes, and hair
					'''
			}

			LayeredEyePatchItem: {
				DisplayName: "{$ItemName.EyePatch} (Layered)"
				Tooltip: Can be worn under hats
			}

			BowstaffItem: {
				DisplayName: Bowstaff
				Tooltip: ""
			}

			WalkingStickItem: {
				DisplayName: Walking Stick
				Tooltip: Slightly increases acceleration
			}

			DisplayDollMakeupItem: {
				DisplayName: Lifelike Makeup Kit
				Tooltip:
					'''
					Use to save your current player style to the kit
					Wear to assume that appearance
					<right> to [c/FF0000:permanently] copy the saved style to this player. [c/FF0000:Be careful!]
					'''
				# Newline so that the player render has vertical space to draw.
				# Using ModItem hooks doesn't adjust the background box size
				CurrentSavedStyleTooltip: Current Saved Style:
				NoSavedStyleTooltip: "{$CurrentSavedStyleTooltip} None!"
			}

			DisplayDollAccessoryStackingItem: {
				DisplayName: Accessory Sack
				Tooltip:
					'''
					Allows visually wearing multiple accessories in one slot
					<right> this item with an accessory in hand to add it
					<right> this item with an empty hand to take an accessory out
					All contained accesories will be dyed the same as this item
					[c/FF0000:Can only be equipped in vanity slots or by (wom)annequins.]
					'''
				ContainsTooltip: "Contains the following accessories: "
				ContainsNothingTooltip: "{$ContainsTooltip}None!"
			}

			UselessDyeItem: {
				DisplayName: Useless Dye
				Tooltip:
					'''
					'A clear veneer, perhaps'
					For use with custom gradient dyes
					'''
			}

			EchoCoatingDyeItem: {
				DisplayName: "{$ItemName.EchoCoating} (Dye)"
				Tooltip: Renders dyed items only visible with Echo Sight
			}

			EchoCoatingAlwaysDyeItem: {
				DisplayName: Potent {$ItemName.EchoCoating} (Dye)
				Tooltip: Renders dyed items invisible, even to Echo Sight
			}

			GlowPaintDyeItem: {
				DisplayName: "{$ItemName.GlowPaint} (Dye)"
				Tooltip:
					'''
					Fully illuminates the dyed object
					Does not work with DIY gradient dyes
					For best effects, apply last using a normal DIY dye!
					'''
			}
		}

		Projectiles.BowstaffProjectile.DisplayName: "{$Items.BowstaffItem.DisplayName}"

		Configs: {
			ClientConfig: {
				DisplayName: Client Config

				ShowStavesWhenHeld: {
					Label: Show Staves When Held
					Tooltip: ""
				}

				ShowTomesWhenHeld: {
					Label: Show Tomes When Held
					Tooltip: ""
				}

				ShowSheathsWhenHeld: {
					Label: Show Sheaths When Held
					Tooltip: ""
				}
			}
		}
	}
}
